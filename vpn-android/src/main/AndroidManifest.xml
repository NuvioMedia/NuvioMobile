<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <provider android:name="com.nuvio.vpn.android.VpnInitializationProvider"
            android:authorities="${applicationId}.nuvio.vpn.init" android:exported="false"
            android:grantUriPermissions="false" android:initOrder="100" />
        <activity android:name="com.nuvio.vpn.android.VpnPlaybackConsentActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:label="@string/vpn_profiles_title" />
        <service android:name="com.wireguard.android.backend.GoBackend$VpnService" android:enabled="true">
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
        </service>
        <service android:name="com.nuvio.vpn.android.WireGuardConnectionService"
            android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="App-restricted WireGuard VPN connection" />
        </service>
        <activity
            android:name="com.nuvio.vpn.android.VpnProfilesActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:label="@string/vpn_profiles_title" />
    </application>
</manifest>
