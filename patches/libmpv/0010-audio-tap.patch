diff --git a/include/mpv/audio_tap.h b/include/mpv/audio_tap.h
new file mode 100644
index 0000000..bdd0254
--- /dev/null
+++ b/include/mpv/audio_tap.h
@@ -0,0 +1,115 @@
+/*
+ * Low-overhead audio tap API for libmpv.
+ *
+ * Allows an embedding application to passively read decoded mono PCM audio
+ * frames with media-timeline timestamps from a lock-free SPSC ring buffer
+ * without disturbing audio playback, routing, or volume/mute state.
+ */
+
+#ifndef MPV_CLIENT_API_AUDIO_TAP_H_
+#define MPV_CLIENT_API_AUDIO_TAP_H_
+
+#include <stdint.h>
+#include "client.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MPV_AUDIO_TAP_API_VERSION 1u
+#define MPV_AUDIO_TAP_DEFAULT_RING_SAMPLES 65536u
+#define MPV_AUDIO_TAP_MIN_RING_SAMPLES 8192u
+#define MPV_AUDIO_TAP_MAX_RING_SAMPLES 262144u
+
+typedef struct mpv_audio_tap mpv_audio_tap;
+
+enum mpv_audio_tap_flags {
+    MPV_AUDIO_TAP_FLAG_NONE = 0,
+    /** Audio stream is encoded passthrough (e.g. S/PDIF/HDMI bitstream), not PCM. */
+    MPV_AUDIO_TAP_FLAG_NON_PCM = 1u << 0,
+    /** One or more frames were dropped due to ring overflow before this chunk. */
+    MPV_AUDIO_TAP_FLAG_DROPPED = 1u << 1,
+    /** The mpv instance was destroyed or detached from this tap. */
+    MPV_AUDIO_TAP_FLAG_EOF = 1u << 2,
+    /** Playback speed is not 1.0; frames are skipped while time-stretched. */
+    MPV_AUDIO_TAP_FLAG_SPEED_MISMATCH = 1u << 3,
+};
+
+typedef struct mpv_audio_tap_config {
+    /** Must be set to sizeof(mpv_audio_tap_config). */
+    uint32_t struct_size;
+    /** Must be set to MPV_AUDIO_TAP_API_VERSION. */
+    uint32_t api_version;
+    /**
+     * Mono float32 sample capacity (rounded up to a power of two and clamped to
+     * [MPV_AUDIO_TAP_MIN_RING_SAMPLES, MPV_AUDIO_TAP_MAX_RING_SAMPLES]).
+     * Pass 0 for MPV_AUDIO_TAP_DEFAULT_RING_SAMPLES (65536 = 256 KiB).
+     */
+    uint32_t ring_capacity_samples;
+    /** Reserved for future options; must be 0. */
+    uint32_t flags;
+} mpv_audio_tap_config;
+
+typedef struct mpv_audio_tap_chunk {
+    /** Caller must set to sizeof(mpv_audio_tap_chunk). */
+    uint32_t struct_size;
+    /** Sample rate in Hz of the returned mono float32 samples. */
+    uint32_t sample_rate;
+    /** Number of mono float32 samples written to out_samples. */
+    uint32_t sample_count;
+    /** Monotonic counter incremented on seek, reset, track switch, or gap. */
+    uint32_t generation;
+    /** Media-timeline start timestamp in microseconds. */
+    int64_t pts_us;
+    /** Bitmask of enum mpv_audio_tap_flags. */
+    uint32_t flags;
+    /** Reserved; set to 0. */
+    uint32_t reserved;
+} mpv_audio_tap_chunk;
+
+/**
+ * Returns MPV_AUDIO_TAP_API_VERSION. Can be resolved via dlsym() to detect
+ * patched libmpv builds at runtime without linking directly.
+ */
+MPV_EXPORT uint32_t mpv_audio_tap_api_version(void);
+
+/**
+ * Attaches a new audio tap to an initialized mpv_handle and allocates its fixed
+ * ring buffer. Replaces any previously attached tap on the same mpv instance.
+ *
+ * Returns NULL on invalid parameters, uninitialized handle, or OOM.
+ */
+MPV_EXPORT mpv_audio_tap *mpv_audio_tap_create(mpv_handle *ctx,
+                                               const mpv_audio_tap_config *cfg);
+
+/**
+ * Non-blocking read of up to max_samples mono float32 samples from the ring.
+ * Must be called from a single consumer thread.
+ *
+ * Returns:
+ *   > 0: number of samples written to out_samples (also in out_meta->sample_count)
+ *     0: no audio available right now (out_meta->flags still reports status bits)
+ *   < 0: invalid arguments
+ */
+MPV_EXPORT int mpv_audio_tap_read(mpv_audio_tap *tap,
+                                  float *out_samples,
+                                  uint32_t max_samples,
+                                  mpv_audio_tap_chunk *out_meta);
+
+/**
+ * Pauses (paused != 0) or resumes (paused == 0) sample capture without freeing
+ * the tap. While paused, mpv's audio path skips downmix and ring writes.
+ */
+MPV_EXPORT void mpv_audio_tap_set_paused(mpv_audio_tap *tap, int paused);
+
+/**
+ * Releases the caller's reference to the tap. Safe to call before or after
+ * mpv_terminate_destroy().
+ */
+MPV_EXPORT void mpv_audio_tap_destroy(mpv_audio_tap *tap);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MPV_CLIENT_API_AUDIO_TAP_H_ */
