+mpv_audio_tap *mpv_audio_tap_create(mpv_handle *ctx,
+                                    const mpv_audio_tap_config *cfg)
+{
+    if (!ctx || !ctx->mpctx || !ctx->mpctx->initialized ||
+        mp_is_shutting_down(ctx->mpctx))
+        return NULL;
+    mp_dispatch_lock(ctx->mpctx->dispatch);
+    mpv_audio_tap *tap = NULL;
+    if (ctx->mpctx->initialized && !mp_is_shutting_down(ctx->mpctx))
+        tap = mp_audio_tap_attach(ctx->mpctx, cfg);
+    mp_dispatch_unlock(ctx->mpctx->dispatch);
+    return tap;
+}
