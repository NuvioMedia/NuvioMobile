# Lentra self-hosted backend — environment template
#
#   cp .env.example .env
#   then EDIT EVERY SECRET BELOW. Do not deploy with defaults.
#
# Generate strong values with:  openssl rand -base64 48
#
# IMPORTANT: JWT tokens. ANON_KEY and SERVICE_ROLE_KEY are *signed JWTs* —
# you cannot make them up as random strings. Generate them from JWT_SECRET:
#
#   node -e 'const c=require("crypto");const s=process.env.JWT_SECRET;
#     const b=o=>Buffer.from(JSON.stringify(o)).toString("base64url");
#     const mk=r=>{const h=b({alg:"HS256",typ:"JWT"});const p=b({role:r,iss:"supabase",iat:Math.floor(Date.now()/1e3),exp:Math.floor(Date.now()/1e3)+60*60*24*365*10});
#     const g=c.createHmac("sha256",s).update(h+"."+p).digest("base64url");return h+"."+p+"."+g};
#     console.log("ANON_KEY="+mk("anon"));console.log("SERVICE_ROLE_KEY="+mk("service_role"))'
#
# Then paste the two values below. ANON_KEY must also go into
# discovery/nuvio.json as "publishable_key" — they have to match exactly.

# === Public URLs =============================================================
# The host the APP will reach. Use your LAN IP or public domain — NOT localhost,
# because the phone cannot resolve your machine's localhost.
API_EXTERNAL_URL=http://192.168.1.50
SUPABASE_PUBLIC_URL=http://192.168.1.50
SITE_URL=http://192.168.1.50

# === Postgres ================================================================
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# === Auth / JWT ==============================================================
# MUST be at least 32 characters. Everything derives from this.
JWT_SECRET=CHANGE_ME_super_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRY=3600

# Signed JWTs — see the generator script at the top of this file.
ANON_KEY=CHANGE_ME_generated_anon_jwt
SERVICE_ROLE_KEY=CHANGE_ME_generated_service_role_jwt

# Realtime
SECRET_KEY_BASE=CHANGE_ME_64_char_random_string

# === Signup policy ===========================================================
# The discovery document advertises email_password_auth: true, and the app calls
# auth.signUpWith(Email) / auth.signInWith(Email).
DISABLE_SIGNUP=false
# true = no confirmation email needed (fine for a personal server).
# Set false and configure SMTP below for anything multi-user.
ENABLE_EMAIL_AUTOCONFIRM=true

# === SMTP (only needed when ENABLE_EMAIL_AUTOCONFIRM=false) ==================
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADDITIONAL_REDIRECT_URLS=

# === Dashboard (Supabase Studio) =============================================
# Do NOT expose this to the public internet.
DASHBOARD_USERNAME=lentra
DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password

# === Optional ================================================================
STUDIO_DEFAULT_ORGANIZATION_NAME=Lentra
STUDIO_DEFAULT_PROJECT_NAME=Lentra Backend
PGRST_DB_SCHEMAS=public,storage,graphql_public
IMGPROXY_ENABLE_WEBP_DETECTION=true
