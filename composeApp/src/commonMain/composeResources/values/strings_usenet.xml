    <string name="usenet_max_missing_articles">Max missing articles</string>
    <string name="usenet_max_missing_articles_description">Total missing articles allowed in one playback (1–50). Lower values give up on damaged videos sooner.</string>
    <string name="usenet_max_consecutive_missing">Max missing in a row</string>
    <string name="usenet_max_consecutive_missing_description">Largest gap allowed in a row (1–10). Lower values allow only smaller interruptions. Essential header articles are never filled.</string>
    <string name="usenet_read_ahead">Read-ahead segments</string>
    <string name="usenet_read_ahead_description">Prepares upcoming segments within the performance profile’s memory budget. Applies to the next stream.</string>
    <string name="usenet_prefetch_results">Prefetch first result</string>
    <string name="usenet_prefetch_results_description">Opens the first Usenet result as soon as the stream list shows, and keeps it ready for two minutes. Uses provider connections, some data and an NZB download from your indexer.</string>
    <string name="usenet_prewarm">Pre-warm engine</string>
    <string name="usenet_prewarm_description">Keeps the engine ready while you browse. Uses extra memory; it does not connect to your providers.</string>
    <string name="usenet_user_agent">User-Agent</string>
    <string name="usenet_search_user_agent">Search User-Agent</string>
    <string name="usenet_search_user_agent_description">How Nuvio names itself for indexer searches, capability checks and connection tests. Change it only if an indexer asks for a different one.</string>
    <string name="usenet_download_user_agent">NZB download User-Agent</string>
    <string name="usenet_download_user_agent_description">How Nuvio names itself when it downloads NZBs. An addon’s own User-Agent takes precedence. Change it only if an indexer asks for a different one.</string>
    <string name="usenet_user_agent_default">%1$s (default)</string>
