    <string name="settings_licenses_attributions_usenet_title">Nuvio Usenet engine</string>
    <string name="settings_licenses_attributions_usenet_body">Streams NZB releases from your NNTP providers. Runs as a separate program on this device; its third-party notices are bundled with the app.</string>
