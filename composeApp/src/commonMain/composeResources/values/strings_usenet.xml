    <string name="usenet_ranking_balanced">Balanced</string>
    <string name="usenet_ranking_balanced_desc">Quality tiers and trusted release groups, with a preference for movies under 30 GB and episodes under 5 GB. Larger releases remain available.</string>
    <string name="usenet_ranking_best">Best Quality</string>
    <string name="usenet_ranking_best_desc">Prioritize remuxes, high-quality encodes and trusted release groups. 1080p remuxes rank above 4K WEB-DL. No preferred size ceiling.</string>
    <string name="usenet_ranking_smaller">Smaller Files</string>
    <string name="usenet_ranking_smaller_desc">Prefer 1080p WEB releases and efficient codecs, with movies under 12 GB and episodes under 2 GB. Keep larger alternatives below.</string>
    <string name="usenet_ranking_hd_sdr">1080p / SDR</string>
    <string name="usenet_ranking_hd_sdr_desc">Prefer 1080p and 720p releases without HDR or Dolby Vision labels, with a boost for AVC video and AAC or Dolby Digital Plus audio. Keep other formats as alternatives.</string>
    <string name="usenet_ranking_language">Preferred language</string>
