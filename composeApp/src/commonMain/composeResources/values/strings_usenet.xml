    <string name="usenet_ranking_languages">Preferred languages</string>
    <string name="usenet_ranking_languages_hint">Comma-separated codes, in order: en, ja, nl, de, fr, es, it, pt, ko, zh, hi, ru, uk, ar, pl, tr, multi, dual. Language tags are inferred from release names; missing tags remain eligible.</string>
    <string name="usenet_ranking_movie_size">Preferred movie size (GB)</string>
    <string name="usenet_ranking_episode_size">Preferred episode size (GB)</string>
    <string name="usenet_ranking_size_hint">A preference, not a filter. Larger releases stay below. 0 means no preference. Season packs use per-episode size when known; unknown sizes remain eligible.</string>
    <string name="usenet_ranking_bucket">Top results per category</string>
    <string name="usenet_ranking_bucket_hint">Keep this many results per resolution/quality category near the top. Extra releases follow and remain available. 0 keeps the strict sorted order.</string>
    <string name="usenet_ranking_priorities">Sorting priorities</string>
    <string name="usenet_ranking_priorities_hint">Applied from top to bottom. Move Rule score above Quality tier to let strong scoring rules outweigh a quality tier. Known failed releases always remain below eligible releases.</string>
    <string name="usenet_ranking_tiers">Quality tiers</string>
    <string name="usenet_ranking_tiers_hint">First matching tier wins. Empty resolutions or qualities match any value. Unmatched and unknown releases remain eligible below named tiers.</string>
    <string name="usenet_ranking_rules">Rules</string>
    <string name="usenet_ranking_rules_hint">All matching score rules add their points. Require and Exclude are filters; set a minimum remaining count to apply a filter only when enough alternatives remain. Rules use release names and indexer metadata, not media probes.</string>
