    <string name="usenet_exclude_full_disc">Exclude full Blu-ray and DVD discs</string>
    <string name="usenet_exclude_full_disc_description">Hide whole disc releases. A Blu-ray disc plays from its feature clip; a DVD disc does not play. Remuxes of a disc always show.</string>
    <string name="usenet_indexer_fallback">Search lower priorities only as fallback</string>
    <string name="usenet_indexer_fallback_description">Off: every indexer is searched. On: lower-priority indexers are only searched when the higher ones find nothing, which saves API hits.</string>
    <string name="usenet_hide_duplicates">Hide repeated releases</string>
    <string name="usenet_hide_duplicates_description">Show a release found by several indexers once, from the indexer with the highest priority.</string>
    <string name="usenet_show_release_names">Show release names</string>
    <string name="usenet_show_release_names_description">Show the release name of each result above its size, age and indexer.</string>
    <string name="usenet_progressive_results">Show results as each indexer answers</string>
    <string name="usenet_progressive_results_description">Off: the list appears once every indexer answered, or after 5 seconds if one is slow, and fills in from there. On: it grows and reorders as each indexer answers.</string>
    <string name="usenet_available_first">Show available releases first</string>
    <string name="usenet_available_first_description">Releases labelled AVAILABLE played recently with your providers, here or in another episode of the same pack. On: they are listed first whatever the sort. Off: they keep their place.</string>
    <string name="usenet_profile">Performance profile</string>
    <string name="usenet_profile_description">Memory and streaming presets. Changes apply to the next stream.</string>
    <string name="usenet_low_memory">Low memory</string>
    <string name="usenet_balanced">Balanced</string>
    <string name="usenet_throughput">High throughput</string>
    <string name="usenet_connections">Max connections</string>
    <string name="usenet_connections_description">Limits the combined connections of your providers. Automatic uses each provider’s allowance.</string>
    <string name="usenet_automatic">Automatic</string>
    <string name="usenet_fast_mkv">Fast MKV startup</string>
    <string name="usenet_fast_mkv_description">Prepare the video’s beginning and seek index together. Uses a little extra bandwidth and memory. Applies to the next stream.</string>
    <string name="usenet_fast_nzb">Fast NZB fetch</string>
    <string name="usenet_fast_nzb_description">Request compressed NZB metadata to reduce startup latency. Applies to the next stream.</string>
    <string name="usenet_cache_nzb">Cache NZB files</string>
    <string name="usenet_cache_nzb_description">Keep downloaded NZBs for 14 days, up to 256 MiB, so playing a release again does not grab it again. Turning this off clears the cache.</string>
    <string name="usenet_self_hosted">Allow self-hosted servers</string>
    <string name="usenet_self_hosted_description">Allow NZB and provider addresses on your local network or this device. Enable only for trusted addons and self-hosted services. Applies to the next stream.</string>
    <string name="usenet_hole_filling">Fill missing articles</string>
