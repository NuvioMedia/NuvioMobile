    <string name="usenet_fallback_description">When a Usenet release fails to open or play, try the following Usenet releases in the list, up to the attempt limit. Torrents and other sources are never switched to.</string>
    <string name="usenet_fallback_max_attempts">Max fallback attempts</string>
    <string name="usenet_fallback_max_attempts_description">Try up to this many following releases (1–50). All attempts share a two-minute preparation budget.</string>
